# Given a Windows-style Unix path starting with `/c/`, add the required semicolon.
clean_path() {
    echo $1 | sed 's#^/c/#/c:/#'
}

clink() {
    mkdir -p ~/.pi/agent/sessions
    podman run -it --rm \
        --init \
        --hostname pi.local \
        --env LLAMA_SERVER_URL=${LLAMA_SERVER_URL:-http://host.containers.internal:9931} \
        --env MEILISEARCH_URL=${MEILISEARCH_URL:-http://host.containers.internal:7700} \
        --volume "$(clean_path "$HOME")/.pi/agent/sessions:/home/user/.pi/agent/sessions" \
        --volume "$(clean_path "$PWD"):/home/user/$(basename "$PWD")" \
        the-clink-pi \
        bash -i -c "git config --global --add safe.directory /home/user/$(basename "$PWD"); \
            cd /home/user/$(basename "$PWD"); pi --approve; exec bash"
}
